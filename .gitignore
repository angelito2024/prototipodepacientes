# Copia local previa al rediseño (el historial de git ya cumple esa función)
centro-psicologico.backup.html

# Credenciales locales: no se versionan (usar config/config.ejemplo.php)
/config/config.php

# Adjuntos clínicos: datos de pacientes, jamás en el repositorio
/storage/

# Respaldos exportados desde el panel
backup-centro-psicologico-*.json

# Diagnóstico financiero: son cifras privadas de Luis, no del programa
diagnostico-*.md

# Las copias de la base son datos de pacientes: nunca al repositorio
respaldo/copias/

# Protocolos de pruebas psicológicas en Excel: llevan el nombre del paciente
# y sus respuestas. Además, el contenido del MCMI-IV y del ICE BarOn tiene
# derechos de autor: el repositorio guarda el programa que los corrige, nunca
# los ítems ni los baremos.
*.xls
*.xlsx
*.xlsm
/pruebas/contenido/

# La contraseña con que se cifran las copias que salen del local.
# Jamás al repositorio: con ella, una copia robada se vuelve legible.
/respaldo/clave.txt

# Modelos de documentos que subió Luis para mejorar el sistema: son
# informes reales, con nombres de pacientes y contenido clínico. Sirven
# de referencia para construir las plantillas; no se versionan.
/documentos para mejora de la pagina/

# Videos y capturas de pantalla del panel: muestran nombres de pacientes.
# Nunca al repositorio, que es público.
*.mp4
*.mov
*.mkv
*.webm
*.avi

# Los formatos del programa de practicantes llevan el DNI del gerente y
# los datos de la empresa ya impresos. El programa los sirve; el
# repositorio no los guarda.
/practicantes/formatos/

# Packs de material comprado o descargado. Pesan cientos de megas y son de
# otros autores: el repositorio guarda el programa, no la biblioteca. Los
# archivos viven en storage/ y el importador los registra desde ahí.
/materiales/*/

# La segunda copia de los formatos del practicante. Son los mismos PDF que
# /practicantes/formatos/ —comprobado byte por byte— y llevan impreso el DNI
# del gerente, así que la regla de arriba no sirve de nada si entran por aquí.
/src/Pruebas/Magusa_Programa_Practicantes/
