# Copia local previa al rediseño (el historial de git ya cumple esa función)
centro-psicologico.backup.html

# Credenciales locales: no se versionan (usar config/config.ejemplo.php)
/config/config.php

# Adjuntos clínicos: datos de pacientes, jamás en el repositorio
/storage/

# Respaldos exportados desde el panel
backup-centro-psicologico-*.json

# Diagnóstico financiero: son cifras privadas de Luis, no del programa
diagnostico-*.md

# Las copias de la base son datos de pacientes: nunca al repositorio
respaldo/copias/

# Protocolos de pruebas psicológicas en Excel: llevan el nombre del paciente
# y sus respuestas. Además, el contenido del MCMI-IV y del ICE BarOn tiene
# derechos de autor: el repositorio guarda el programa que los corrige, nunca
# los ítems ni los baremos.
*.xls
*.xlsx
*.xlsm
/pruebas/contenido/

# La contraseña con que se cifran las copias que salen del local.
# Jamás al repositorio: con ella, una copia robada se vuelve legible.
/respaldo/clave.txt
